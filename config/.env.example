# Copy to the environment used by the launcher if you need overrides.
# The Windows installer writes its resolved values into the WSL data directory.

BREEZE_MODEL_ID=BreezeBlue/Breeze-TTS-2
BREEZE_IDLE_TIMEOUT=120
BREEZE_GEN_TIMEOUT=180
BREEZE_GEN_STALL=45
BREEZE_LOCK_TIMEOUT=300
BREEZE_PORT=7860
BREEZE_PROXY_PORT=9000
BREEZE_FAST_MODE=fast-all

# Use the normal public endpoints outside mainland China. The defaults in the
# Windows installer are optimized for the user's known network and can be
# overridden with -TorchIndexUrl/-PypiIndexUrl/-HfEndpoint.
HF_ENDPOINT=https://hf-mirror.com
TORCH_INDEX_URL=https://mirror.sjtu.edu.cn/pytorch-wheels/cu128
PYPI_INDEX_URL=https://pypi.org/simple
